{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "src/**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "styles/**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
